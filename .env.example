# Start local, then switch PIPELINE_MODE=cloud after configuring AWS/Snowflake.
PIPELINE_MODE=local
ROWS=2000000
TRAIN_MODEL=true
# TRAIN_MODEL controls explicit training/bootstrap commands only.
# The scheduled DAG always uses champion and never trains or creates source tables.
# Set this before enabling the scheduled cloud DAG (simple unquoted identifiers).
SNOWFLAKE_SCORE_TABLE=
TRAIN_AS_OF=2026-05-01
# Leave empty for execution date (UTC). On the demo day this agrees with IST.
SCORE_AS_OF=
SPARK_MASTER=local[4]
SPARK_DRIVER_MEMORY=4g
SPARK_PARTITIONS=16
MODEL_NAME=credit_card_churn
MIN_TEST_AUC=0.60
# Runs daily at 08:00 Asia/Kolkata, leaving time before the 14:00 deadline.
DAG_SCHEDULE=0 8 * * *
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=CHANGE_ME_LOCAL_PASSWORD
POSTGRES_PASSWORD=CHANGE_ME_DATABASE_PASSWORD
AIRFLOW_FERNET_KEY=
AIRFLOW_WEBSERVER_SECRET_KEY=CHANGE_ME_RANDOM_LONG_STRING
AWS_DEFAULT_REGION=ap-south-1
S3_BUCKET=
S3_PREFIX=churn-poc
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=CHURN_SVC
SNOWFLAKE_ROLE=CHURN_POC_ROLE
SNOWFLAKE_WAREHOUSE=CHURN_POC_WH
SNOWFLAKE_DATABASE=CHURN_POC_DB
SNOWFLAKE_SCHEMA=PUBLIC
SNOWFLAKE_STORAGE_INTEGRATION=CHURN_POC_S3
SNOWFLAKE_PRIVATE_KEY_FILE=/opt/airflow/secrets/rsa_key.p8
SNOWFLAKE_PRIVATE_KEY_PASSPHRASE=

# CI/CD sets this to an ECR image digest on EC2; local default remains unchanged.
CHURN_IMAGE=credit-card-churn:0.1
